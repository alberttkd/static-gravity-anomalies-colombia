              "max_distance_m": 5000.0,
              "max_sigma_mgal": 5.0,
              "use_convex_hull": true
            }
          },
          "matern_nu": {
            "anyOf": [
              {
                "type": "number"
              },
              {
                "const": "auto",
                "type": "string"
              }
            ],
            "default": "auto",
            "title": "Matern Nu"
          },
          "max_lag_m": {
            "default": 30000.0,
            "maximum": 100000.0,
            "minimum": 5000.0,
            "title": "Max Lag M",
            "type": "number"
          },
          "method": {
            "default": "auto",
            "enum": [
              "auto",
              "rk_matern",
              "eqs",
              "idw",
              "spline"
