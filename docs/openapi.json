            "title": "Target",
            "type": "string"
          },
          "trend_degree": {
            "default": "auto",
            "enum": [
              0,
              1,
              2,
              "auto"
            ],
            "title": "Trend Degree"
          }
        },
        "title": "GriddingConfig",
        "type": "object"
      },
      "GriddingRequest": {
        "additionalProperties": false,
        "properties": {
          "config": {
            "$ref": "#/components/schemas/GriddingConfig",
