                "ERROR_SCHEMA",
                "ERROR_RANGE",
                "CONFLICT_SHARED_ID"
              ],
              "mask": {
                "max_distance_m": 5000.0,
                "max_sigma_mgal": 5.0,
                "use_convex_hull": true
              },
              "matern_nu": "auto",
              "max_lag_m": 30000.0,
              "method": "auto",
              "target": "CBA",
              "trend_degree": "auto"
            }
          },
