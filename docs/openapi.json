          "cell_size_m": {
            "default": 500.0,
            "maximum": 5000.0,
            "minimum": 100.0,
            "title": "Cell Size M",
            "type": "number"
          },
          "cv": {
            "$ref": "#/components/schemas/CVConfig",
            "default": {
              "block_size_m": 15000.0,
              "n_splits": 5,
              "random_state": 20261022
            }
          },
          "eqs_dampings": {
            "default": [
              0.01,
              0.1,
              1.0
            ],
            "items": {
              "type": "number"
            },
            "title": "Eqs Dampings",
            "type": "array"
          },
          "eqs_depths_m": {
            "default": [
              7000.0,
              10000.0,
              14000.0,
              20000.0
