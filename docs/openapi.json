            "items": {
              "maximum": 3500.0,
              "minimum": 1000.0,
              "type": "number"
            },
            "maxItems": 2,
            "minItems": 2,
            "title": "Densities",
            "type": "array"
          }
        },
        "title": "DensityRequest",
        "type": "object"
      },
      "GriddingConfig": {
