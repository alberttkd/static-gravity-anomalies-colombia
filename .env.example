# Absolute path to the folder holding the legacy workbooks (read-only). Leave empty in public mode.
GRAVANOM_PRIVATE_DATA_DIR=
# Output directory of pipeline runs and API artifacts.
GRAVANOM_ARTIFACTS_DIR=./artifacts
# true disables the private dataset in the API.
GRAVANOM_PUBLIC_MODE=false
# Comma-separated allowed CORS origins.
API_CORS_ORIGINS=http://localhost:5173
LOG_LEVEL=INFO
